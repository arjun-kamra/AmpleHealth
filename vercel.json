{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "regions": ["sfo1"],
  "functions": {
    "app/api/**": {
      "includeFiles": "templates/**"
    }
  },
  "crons": [
    {
      "path": "/api/generate-blog",
      "schedule": "0 9 * * 1"
    }
  ]
}
